#!/bin/bash
# pre-push 훅: 백엔드/프론트엔드 테스트가 하나라도 실패하면 push 자체를 막는다.
#
# git은 훅을 자동으로 동기화하지 않으므로, 이 파일을 고치면 실제로 쓰는
# .git/hooks/pre-push 도 다시 설치해야 반영된다:
#
#   cp .githooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# 급하게 훅을 건너뛰어야 하면 `git push --no-verify`를 쓴다 (AGENTS.md 4번 규칙을
# 우회하는 것이니, 그럴 만한 이유가 있을 때만 쓴다).

set -e

# 이 PC의 Windows용 Python은 Windows Defender Application Control(WDAC)이
# numpy(pandas 의존성)의 컴파일된 DLL 실행을 차단해서 쓸 수 없다. 대신 WSL
# Ubuntu에 별도로 구성해둔 Python 3.12 가상환경(/tmp/venv312)으로 돌린다.
echo "[pre-push] 백엔드 테스트 실행 중 (WSL)..."
REPO_DIR_WIN="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
REPO_DIR_WSL="/mnt/$(echo "${REPO_DIR_WIN}" | sed -E 's#^/([a-zA-Z])/#\1/#; s#^([a-zA-Z])/#\L\1/#')"
wsl -d Ubuntu -- bash -lc "cd '${REPO_DIR_WSL}/backend-py' && /tmp/venv312/bin/python -m pytest tests/ -q"

echo "[pre-push] 프론트엔드 테스트 실행 중..."
(cd frontend && npx vitest run)

echo "[pre-push] 테스트 통과 — push를 진행합니다."
