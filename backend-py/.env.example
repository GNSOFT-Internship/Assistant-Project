DATABASE_URL=mysql+pymysql://asset:assetpass@127.0.0.1:3306/asset_management?charset=utf8mb4
# 이 값은 공개 저장소에 그대로 노출되어 있으므로 반드시 고유한 값으로 바꿔야 합니다.
# (바꾸지 않으면 이 값이 그대로인 채로는 서버가 기동을 거부합니다 - main.py의 startup 검증 참고)
JWT_SECRET=CHANGE_ME_to_a_unique_random_secret
# JWT는 발급 후 무효화할 방법이 없으므로(관리자 권한 회수/계정 삭제/비밀번호
# 변경이 즉시 반영되지 않음) 만료 시간을 짧게 잡아 노출 창을 줄입니다(2시간).
JWT_EXPIRATION_SECONDS=7200
UPLOAD_DIRECTORY=./uploads
DEMO_MODE=true
GN_API_KEY=
GN_MODEL=qwen35

# admin/admin123, user/user123 기본 계정을 자동 생성할지 여부.
# 운영 배포에서는 false(기본값)로 두세요 - true가 아니면서 admin 비밀번호가
# 여전히 admin123이면 서버가 기동을 거부합니다 (main.py의 startup 검증 참고).
SEED_DEFAULT_USERS=false

# X-Real-IP / X-Forwarded-For 헤더를 신뢰할 리버스 프록시(nginx 등)의 IP 목록.
# 이 목록에 없는 곳에서 온 요청은 헤더를 무시하고 TCP 연결의 실제 IP를 사용합니다.
# 배포 환경에서 nginx가 컨테이너 등으로 떠 있다면 그 실제 소스 IP로 바꿔주세요.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# 업로드 파일(엑셀/PDF/배치 업로드) 하나당 허용하는 최대 크기(MB).
# 이 상한을 넘으면 즉시 거부합니다 - 디스크 고갈/메모리 고갈 DoS 방지용.
MAX_UPLOAD_SIZE_MB=20
